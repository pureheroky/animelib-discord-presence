{
  "manifest_version": 3,
  "name": "AnimeLib → Discord Presence",
  "version": "1.0.5",
  "description": "Shows the anime you are watching on AnimeLib in your Discord status.",
  "browser_specific_settings": {
    "gecko": {
      "id": "animelib-presence@pureheroky",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/pureheroky/animelib-discord-presence/main/updates.json"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://animelib.org/*",
        "https://*.animelib.org/*",
        "https://animelib.me/*",
        "https://*.animelib.me/*",
        "https://animelib.top/*",
        "https://*.animelib.top/*",
        "https://anilib.me/*",
        "https://*.anilib.me/*",
        "https://anilib.org/*",
        "https://anilib.top/*",
        "https://anilib.social/*",
        "https://*.anilib.social/*"
      ],
      "js": [
        "content/tap.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://animelib.org/*",
        "https://*.animelib.org/*",
        "https://animelib.me/*",
        "https://*.animelib.me/*",
        "https://animelib.top/*",
        "https://*.animelib.top/*",
        "https://anilib.me/*",
        "https://*.anilib.me/*",
        "https://anilib.org/*",
        "https://anilib.top/*",
        "https://anilib.social/*",
        "https://*.anilib.social/*"
      ],
      "js": [
        "content/collector.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://kodik.info/*",
        "https://*.kodik.info/*",
        "https://kodik.cc/*",
        "https://*.kodik.cc/*",
        "https://kodik.biz/*",
        "https://*.kodik.biz/*",
        "https://kodik.top/*",
        "https://*.kodik.top/*",
        "https://aniqit.com/*",
        "https://*.aniqit.com/*"
      ],
      "js": [
        "content/frame.js"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "736": "icons/extension.jpg"
  },
  "action": {
    "default_title": "AnimeLib → Discord Presence",
    "default_icon": {
      "736": "icons/extension.jpg"
    }
  }
}
